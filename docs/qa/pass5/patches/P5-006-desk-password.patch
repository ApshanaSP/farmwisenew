P5-006, for the owner to accept or reject (not applied). The petition desk's password is published in the public repo
(docs/manu-desk/README.md line 9, src/lib/manu/manu.sqlite.test.ts) and every sign-in attempt puts it back, so it can never be changed.
This patch keeps "the account is there from the first sign-in" but never puts the password back once someone has changed it.
After applying: sign in once, change the desk password on the profile page, and remove the password from README.md and the test.
The existing test "goes back to the fixed password if the account had another one" is replaced by its opposite.

--- a/chennai-grievance-portal-main/src/lib/manu/login.ts
+++ b/chennai-grievance-portal-main/src/lib/manu/login.ts
@@
 export async function ensurePetitionLogin(email: string): Promise<void> {
   if (email !== PETITION_LOGIN_EMAIL) return;
-  const [rows] = await pool.query<RowDataPacket[]>(`SELECT id, password_hash FROM users WHERE email = ? LIMIT 1`, [email]);
+  const [rows] = await pool.query<RowDataPacket[]>(`SELECT id FROM users WHERE email = ? LIMIT 1`, [email]);
   const now = istNow();
   if (!rows[0]) {
     await pool.query(
       `INSERT INTO users (email, password_hash, role, department_id, dept_code, is_active, email_verified_at, email_verification_exempt, token_version, created_at, updated_at)
        VALUES (?, ?, 'department_officer', NULL, ?, 1, ?, 1, 0, ?, ?)`,
       [email, FIXED_HASH, PETITION_DEPT, now, now, now]
     );
-  } else if (rows[0].password_hash !== FIXED_HASH) {
-    // the fixed password goes back, but a deactivated account stays deactivated: anyone can type this email, no password needed
-    // (QA pass 5, P5-005), so this must never undo an administrator's "deactivate"
-    await pool.query(`UPDATE users SET password_hash = ?, dept_code = ?, updated_at = ? WHERE id = ?`, [FIXED_HASH, PETITION_DEPT, now, rows[0].id]);
   }
+  // an existing account is left as it is: a changed password stays changed (QA pass 5, P5-006)
 }
