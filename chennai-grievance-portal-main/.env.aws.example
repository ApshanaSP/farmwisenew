# Run the website on your own PC with the team's AWS data: no MySQL needed.
# Copy this file to .env (in this folder), then fill in the two team secrets below.
# Ask the project owner for them; never commit .env or paste them anywhere public: this repository is public.

DATA_BACKEND=aws

# Team secret 1: the API key for the team's AWS data
REFRESH_API_KEY=
# Team secret 2: must be the team's key, or Aadhaar numbers stored in AWS cannot be read
AADHAAR_ENCRYPTION_KEY=

# Signs your logins on this PC: any long random text of your own
JWT_SECRET=change-me-to-a-long-random-text
JWT_EXPIRES_IN=7d

# Saving to AWS: leave this commented out. Only ONE PC (the project owner's) sets AWS_STORE_SAVE=1.
# Without it everything works on your PC, but nothing you do is saved to AWS and it is gone after a restart.
# Two PCs that save would give new complaints the same numbers and overwrite each other.
# AWS_STORE_SAVE=1

NODE_ENV=development
# Shows OTP codes on screen (there is no email set up for local runs)
NEXT_PUBLIC_DEV_SHOW_OTP=true

# Ask District IQ (chatbot): Amazon Bedrock with your own keys from the FarmwiseAI AWS access portal.
# `npm run ai:key` pastes them in; they expire after a few hours. The rest of the site works without them.
AI_PROVIDER=bedrock
AI_FALLBACK_PROVIDER=none
AWS_REGION=ap-south-1
AI_BEDROCK_MODEL=apac.amazon.nova-lite-v1:0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
TTS_PROVIDER=browser
EMAIL_MODE=sandbox
