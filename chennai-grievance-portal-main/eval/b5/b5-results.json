 "modelNotes": {
  "csn-int8": "120M Tamil mono, CTC head, dynamic int8 (README); 257 tokens; README self-reports FLEURS ta_in test (first 100 distinct sentences) WER 33.5 / CER 16.7 for this file",
  "ovos-fp32": "onnx-asr export, fp32 weights in external data file model.onnx_data; config.json model_type nemo-conformer-ctc, subsampling_factor 4; vocab.txt 257 lines in sherpa sym-id format",
  "ovos-int8": "onnx-asr export, int8, same vocab",
  "doc600-ta-int8": "600M multilingual encoder with a constant mask to the 256 Tamil tokens + blank over the shared 5,633-token CTC head (README); int8"
 },
