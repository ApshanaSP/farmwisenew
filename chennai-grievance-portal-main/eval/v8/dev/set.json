    { "id": "d-own-1", "kind": "owner", "lang": "en", "text": "Open the Supreme Court news on Palikan.", "screen": "newsPanel", "gold": { "story": "supreme court", "lang": "en" }, "note": "the owner's example 1: Palikan is Pallikaranai" },
